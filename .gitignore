# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle's own output. `/build/` above is anchored to the repo root and does not cover
# this one, which is why a `git add -A` after a Gradle run swept a file out of it.
/android/build/
/android/.gradle/

# Signing material, anywhere — not just under android/.
#
# `android/.gitignore` already covers `**/*.jks`, `**/*.keystore` and `key.properties`, but
# only from that directory down. A keystore left at the repo root, or beside a script in
# `tool/`, matches nothing there. This repository is public, and an upload key cannot be
# rotated out of a published history.
*.jks
*.keystore
*.p12
*.mobileprovision
key.properties

# Deliberately NOT `*.pem`: `test/fixtures/` holds a self-signed throwaway pair
# (CN=nestwatch-test-server) that the pinning tests need committed. See test/fixtures/README.md.

# Local secrets and machine-specific settings
.env
.env.*
!.env.example
local.properties
.fvm/

# Test and coverage output
/coverage/
lcov.info
test/failures/

# Editor and OS noise not covered above
.vscode/
*~
